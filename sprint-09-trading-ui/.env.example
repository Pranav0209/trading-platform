# Trading UI E2E Test Environment Variables

# Base URL of the Angular trading UI
TRADING_UI_URL=http://localhost:4200

# Base URL of the auth service (for reference; UI calls it directly)
AUTH_SERVICE_URL=http://localhost:3001

# Base URL of the trade service (for reference; UI calls it directly)
TRADE_SERVICE_URL=http://localhost:3002

# Test account credentials - must be a valid user on the auth service
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword

# Numeric account ID associated with TEST_USERNAME
# The auth service JWT payload must include this accountId
TEST_ACCOUNT_ID=1
