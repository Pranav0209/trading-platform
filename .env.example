# Consolidated environment reference for local development and cloud setup.
# Existing services do not load this file automatically.
# Service-prefixed variables avoid collisions where different stacks use the same key name.

# postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres1
POSTGRES_DB=trading

# Kafka
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,CONTROLLER://0.0.0.0:29093,EXTERNAL://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:29093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Shared application secrets and external APIs
JWT_SECRET=<jwt-secret>
FAUXNANCE_API_KEY=<fauxnance-api-key>
FAUXNANCE_BASE_URL=<fauxnance-base-url>
EMAILJS_SERVICE_ID=<emailjs-service-id>
EMAILJS_TEMPLATE_ID=<emailjs-template-id>
EMAILJS_PUBLIC_KEY=<emailjs-public-key>
EMAILJS_PRIVATE_KEY=<emailjs-private-key>

# Frontend
NG_APP_ENVIRONMENT=development

# Auth service
AUTH_DATABASE_URL=postgresql://postgres:postgres1@localhost:5432/trading
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_SECONDS=900
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
JWT_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
NODE_ENV=development

# Order service
ORDER_DATABASE_URL=jdbc:postgresql://localhost:5432/trading
# Uses shared POSTGRES_USER and POSTGRES_PASSWORD above
DEFAULT_INITIAL_BALANCE=10000.00
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# Executor service
EXECUTOR_DATABASE_URL=jdbc:postgresql://localhost:5432/trading
# Uses shared POSTGRES_USER and POSTGRES_PASSWORD above
FRANKFURTER_BASE_URL=https://api.frankfurter.dev