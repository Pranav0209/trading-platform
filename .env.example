# ============================================
# ETP Trading System - Environment Configuration
# ============================================
# IMPORTANT: Copy this file to .env and replace ALL placeholder values
# Placeholders are marked with <...>
# DO NOT commit the actual .env file to version control
# DO NOT use hardcoded secrets in the application

# ============================================
# Frontend Configuration
# ============================================
# Replace with your actual frontend URLs
NG_APP_AUTH_API_URL=<http://your-auth-service-url:3000>
NG_APP_TRADE_API_URL=<http://your-trade-service-url:8081>
NG_APP_PORT=4200
NG_APP_ENVIRONMENT=<development|staging|production>

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# CHANGE ALL DATABASE CREDENTIALS
DATABASE_URL=postgresql://<db-username>:<db-password>@<db-host>:5432/trading_system_db
DATABASE_USERNAME=<postgres-username>
DATABASE_PASSWORD=<CHANGE-THIS-TO-YOUR-SECURE-PASSWORD>

# ============================================
# Authentication & JWT
# ============================================
# CHANGE JWT_SECRET to a strong random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=<change-this-to-a-random-32-character-secret-string>
JWT_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900

# ============================================
# Kafka Configuration
# ============================================
# Replace with your Kafka broker address
KAFKA_BOOTSTRAP_SERVERS=<kafka-host>:29092

# ============================================
# Service Ports
# ============================================
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082
FRONTEND_PORT=4200
POSTGRES_PORT=5432

# ============================================
# Third-party APIs (Fauxnance)
# ============================================
# CHANGE TO YOUR ACTUAL FAUXNANCE API KEY
FAUXNANCE_API_KEY=<your-fauxnance-api-key-here>
FAUXNANCE_BASE_URL=https://api.fauxnance.com

# ============================================
# Application Settings
# ============================================
NODE_ENV=<development|staging|production>
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_SECONDS=900
POLL_INTERVAL_SECONDS=60
DEFAULT_INITIAL_BALANCE=10000.00

# ============================================
# Logging
# ============================================
LOG_LEVEL=<INFO|DEBUG|WARN|ERROR>
APP_LOG_LEVEL=<DEBUG|INFO|WARN|ERROR>

# ============================================
# Frontend URL (for redirects and CORS)
# ============================================
# Replace with your actual frontend URL
FRONTEND_URL=<http://your-frontend-url:4200>
