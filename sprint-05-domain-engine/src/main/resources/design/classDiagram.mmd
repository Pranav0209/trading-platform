---
title: Zkubaa Application
---
classDiagram

    direction LR

    class Account {
        -Long accountId
        -String accountNumber
        -String holder
        -BigDecimal cashBalance
        -AccountStatus status
        -Long version
        +canAfford(BigDecimal) boolean
        +debit(BigDecimal) void
        +credit(BigDecimal) void
    }



    class Instrument{
        -String symbol
        -String displayName
        -AssetClass assetClass
        -String currency
        -boolean tradable
        +isTradable() boolean
    }

    class AssetClass {
        <<enumeration>>
        EQUITY
        CRYPTO
        FOREX
    }




    class Position  {
        -Long accountId
        -String symbol
        -BigDecimal quantity
        -BigDecimal averageCost
        +buy(BigDecimal, BigDecimal) void
        +sell(BigDecimal) void
    }

    class Order {
        -Long accountId
        -String symbol
        -OrderType type
        -OrderSide side
        -BigDecimal quantity
        -BigDecimal limitPrice
        -String idempotencyKey
        -OrderStatus status
        +fill() void
        +reject() void
        +cancel() void
    }




    class OrderSide {
        <<enumeration>>
        BUY
        SELL
    }

    class OrderStatus {
        <<enumeration>>
        NEW
        FILLED
        REJECTED
        CANCELLED
    }

    class OrderType {
        <<enumeration>>
        MARKET
        LIMIT
    }

%% <|--	Inheritance
%%    *--	Composition
%%    o--	Aggregation
%%    -->	Association
  %%  --	Link (Solid)
    %% ..>	Dependency
%%    ..|>	Realization
 %%   ..	Link (Dashed)


    class AccountStatus{
    <<enumeration>>
        ACTIVE
        SYSPENDED
        CLOSED
    }

    Account ..> AccountStatus
    Order ..> OrderType
    Order ..> OrderSide
    Order ..> OrderStatus
    Instrument ..> AssetClass

    Account "1" --> "0..*" Position
    Instrument "1" --> "0..*" Position
    Account "1" --> "0..*" Order
    Instrument "1" --> "0..*" Order
