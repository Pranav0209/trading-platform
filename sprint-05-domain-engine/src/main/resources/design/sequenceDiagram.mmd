%% {init: {'sequence': {'mirrorActors': false}}}


sequenceDiagram


    actor C as Client
    participant O as Order
    participant A as Account
    participant I as Instrument
    participant P as Position
    participant S as Service

    C->>O: Place order

    O->>S: 1. accountExists()
    alt Account not found
        S-->>O: Account Not found
        O-->>C: ACC-404
    else Account exists
        S-->>O: AccountId
        O->>A: 2. accountActive()
        alt Account inactive
            A-->>O: Not Active
            O-->>C: ACC-403
        else Active
            O->>S: 3.1 instrumentFound()
            alt Insturment not found
                S-->>O: Not found
                O-->>C: INS-404 instrument is not found
            else Instrument Found
                O->>I: 3.2 instrumentValid()
                alt Instrument not valid
                    I-->>O: Not found
                    O-->>C: INS-404 instrument is delisted
                else Inst Valid
                    O->>O: 4. Quantity is positive?
                    alt Invalid quantity
                        O-->>C: VAL-422 Quantity is not positive
                    else valid quantity

                        O->>O: 5. Price is positive?
                        alt Invalid price
                            O-->>C: VAL-422 Price is not positive
                        else Valid price

                            alt BUY
                                O->>A: 6. Suffient funds found?
                                alt Insufficient funds
                                    A-->>O: Refuse
                                    O-->>C: ORD-400 Insufficient funds
                                else sufficient funds
                                end
                            end

                            alt SELL
                                O->>P: 7. Held quantity sufficient?
                                alt Insufficient holdings
                                    P-->>O: Not enough holdings
                                    O-->>C: ORD-410 Insufficient holdings to sell
                                else Sufficient holdings
                                end
                            end
                        end
                    end
                end
            end
             O->>I: 8. Key already used?
                alt Duplicate
                    I-->>O: Exists
                    O-->>C: Duplicate order
                else New key
                    I-->>O: Available
                    O->>O: Create order as NEW
                    O-->>C: Order accepted
                end
        end
    end