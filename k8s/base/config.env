# NON-SECRET settings for auth / order / executor (ConfigMap etp-config).
# Edit, then kubectl apply -k k8s/base (or overlays):
# Secrets (DB_PASSWORD, JWT_SECRET, API keys) are in secrets.env.

# ---- Database (AWS RDS) ----
# Note: auth service uses schema 'auth', all remaining tables reside in schema 'public'.
DB_HOST=database-1.cziio68eid23.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DATABASE_USERNAME=postgres
DB_SCHEMA_AUTH=auth
DB_SCHEMA_TRADE=public
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.cziio68eid23.ap-south-1.rds.amazonaws.com:5432/postgres?currentSchema=public&sslmode=require
DATABASE_URL=postgresql://postgres:password@database-1.cziio68eid23.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=no-verify

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- Service Ports ----
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082
FRONTEND_PORT=80

# ---- Security ----
JWT_ISSUER=auth-service
JWT_ALGORITHM=HS256
JWT_TOKEN_EXPIRY=15m

# ---- Application & Logging ----
NODE_ENV=development
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# ---- Internal Service Addresses & Routing ----
AUTH_SERVICE_URL=http://auth-service:3000
ORDER_SERVICE_URL=http://order-service:8081
ORDER_SERVICE_BASE_URL=http://order-service:8081
CORS_ORIGINS=*
CORS_ALLOWED_ORIGINS=*

# ---- Market Data & Third-Party APIs ----
FAUXNANCE_BASE_URL=http://mock-fauxnance:3001/v1
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev
POLL_INTERVAL_SECONDS=60

# ---- EmailJS Notifications (Non-Secrets) ----
EMAILJS_SERVICE_ID=service_y8pcplk
EMAILJS_TEMPLATE_ID=template_bmlhlpz
EMAILJS_PUBLIC_KEY=yuT3IV4vrm0rxBva7
